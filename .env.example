# Shared local and Docker configuration. Use a URL-safe PostgreSQL password.
POSTGRES_DB=library_db
POSTGRES_USER=library_app
POSTGRES_PASSWORD=library_app_password
JWT_SECRET_KEY=replace-with-a-cryptographically-random-secret
# Comma-separated browser origins allowed to call the API, for example:
# CORS_ALLOWED_ORIGINS=https://library-app.vercel.app
CORS_ALLOWED_ORIGINS=
